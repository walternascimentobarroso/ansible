services:
  stirlingpdf:
    image: stirlingtools/stirling-pdf:3.0.2
    container_name: stirlingpdf
    restart: unless-stopped
    mem_limit: 1g
    cpus: 1.0

    ports:
      - "8080:8080"

    environment:
      SECURITY_ENABLELOGIN: "false"
      DISABLE_ADDITIONAL_FEATURES: "true"

    volumes:
      - /opt/apps/stirlingpdf/data:/configs
