services:
  resume-matcher:
    image: ghcr.io/srbhr/resume-matcher:1.3.0
    container_name: resume-matcher
    restart: unless-stopped
    mem_limit: 1g
    cpus: 1.0

    ports:
      - "3000:3000"

    environment:
      LLM_PROVIDER: ollama
      LLM_MODEL: {{ sandbox_ollama_model }}
      LLM_API_BASE: {{ sandbox_ollama_url }}
      FRONTEND_BASE_URL: https://resume.{{ homelab_domain }}

    volumes:
      - /opt/apps/resume-matcher/data:/app/backend/data
