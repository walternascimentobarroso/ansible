services:
  homepage:
    image: ghcr.io/gethomepage/homepage:v2.7.0
    container_name: homepage
    restart: unless-stopped
    mem_limit: 256m
    cpus: 0.5

    ports:
      - "3001:3000"

    environment:
      HOMEPAGE_ALLOWED_HOSTS: "dashboard.{{ homelab_domain }}"

    volumes:
      - /opt/apps/homepage/data:/app/config
