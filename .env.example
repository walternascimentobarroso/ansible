PROXMOX_HOST=PROXMOX_HOST
PROXMOX_USER=PROXMOX_USER
PROXMOX_TOKEN_ID=PROXMOX_TOKEN_ID
PROXMOX_TOKEN_SECRET=PROXMOX_TOKEN_SECRET

HOMELAB_DOMAIN=home.arpa

# Nextcloud app
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=NEXTCLOUD_DB_PASSWORD

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=NEXTCLOUD_ADMIN_PASSWORD

# pi-hole app
PIHOLE_VERSION=v6.4.3
PIHOLE_UPSTREAM_DNS=1.1.1.1,1.0.0.1
PIHOLE_ADMIN_PASSWORD=PIHOLE_ADMIN_PASSWORD

# Pi-hole DHCP
PIHOLE_DHCP_START=192.168.1.20
PIHOLE_DHCP_END=192.168.1.254
PIHOLE_DHCP_ROUTER=192.168.1.1
PIHOLE_DHCP_NETMASK=255.255.255.0
PIHOLE_DHCP_LEASE_TIME=24h
PIHOLE_DHCP_ENABLED=true

# LLM providers (Resume Matcher, Open WebUI)
GROQ_API_KEY=GROQ_API_KEY
GEMINI_API_KEY=GEMINI_API_KEY

# Open WebUI admin API key (Settings > Account > API Keys)
OPENWEBUI_API_KEY=OPENWEBUI_API_KEY

# NOS router (factory credentials after a reset)
ROUTER_USER=admin
ROUTER_PASSWORD=admin

# Vaultwarden app (token: argon2 hash from `vaultwarden hash`, single-quoted so Compose does not expand its "$")
VAULTWARDEN_ADMIN_PASSWORD=VAULTWARDEN_ADMIN_PASSWORD
VAULTWARDEN_ADMIN_TOKEN='VAULTWARDEN_ADMIN_TOKEN'
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Home Assistant integrations (configured in the HA UI, not by Ansible)
HA_PROXMOX_TOKEN_SECRET=HA_PROXMOX_TOKEN_SECRET
HA_NEXTCLOUD_APP_PASSWORD=HA_NEXTCLOUD_APP_PASSWORD
