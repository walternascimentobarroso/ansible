services:
  hermes:
    image: nousresearch/hermes-agent:v0.22.5
    container_name: hermes
    restart: unless-stopped
    command: ["gateway", "run"]

    ports:
      - "9119:9119"

    environment:
      HERMES_DASHBOARD: "1"
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "{{ hermes_dashboard_user }}"
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: "{{ hermes_dashboard_password | replace('$', '$$') }}"
      TELEGRAM_BOT_TOKEN: "{{ hermes_telegram_bot_token }}"
      TELEGRAM_ALLOWED_USERS: "{{ hermes_telegram_allowed_users }}"

    volumes:
      - /opt/hermes/data:/opt/data
